{# Create a category query with the 'group' parameter #}
{% set navQuery = craft.categories()
  .group('portfolioCategories') %}

{# Fetch the categories #}
{% set categories = navQuery.all() %}


{% macro navLink(text, url) %}
  <a 
    href="{{ url }}" 
    class="navLinks p-[10px] uppercase text-gray-400 font-light tracking-[6px]" 
    style="--hover-color:#{{ globals.contrastColorOne }};">
    {{ text }}
  </a>
{% endmacro %}

<nav class="flex flex-col lg:flex-row items-center justify-between w-full px-[20px] py-[10px] md:px-[3vw] bg-[#011d22]">
  <div class="flex flex-row justify-between w-full flex-wrap">
    {{ _self.navLink('Home', '/') }}
    {{ _self.navLink('About', '/about') }}

    {% for category in categories %}
      {{ _self.navLink(category.title, category.url) }}
    {% endfor %}

    {{ _self.navLink('Contact', '/contact') }}
  </div>
</nav>

