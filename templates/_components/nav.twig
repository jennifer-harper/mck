{# Create a category query with the 'group' parameter #}
{% set navQuery = craft.categories().group('portfolioCategories') %}
{% set categories = navQuery.all() %}

{% macro navLink(text, url) %}
  <a 
    href="{{ url }}" 
    class="nav-anchor block p-[20px] text-center uppercase text-gray-400 font-light tracking-[6px] hover:text-[var(--hover-color)] transition-colors duration-300"
    style="--hover-color:#{{ globals.contrastColorOne }};">
    {{ text }}
  </a>
{% endmacro %}

<nav style="background-color: #{{ globals.darkBackground }};" class="px-[20px] md:px-[3vw] py-[10px] z-50 flex fixed w-full">
  <div class="flex items-center justify-between  w-full xl:w-auto z-100 relative">
    <!-- Logo -->
    <a href="/" class="flex-shrink-0 w-[40px] h-[40px] xl:w-[2vw] xl:h-[2vw]">
        <svg viewBox="0 0 181 180" fill="none" xmlns="http://www.w3.org/2000/svg" fill="#ffffff">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M90.1 0C40.3 0 0 40.3 0 90C0 139.7 40.4 180 90.1 180C139.8 180 180.2 139.7 180.2 90C180.2 40.3 139.8 0 90.1 0ZM129.8 58.4C126.8 59.7 125 61.9 125 65.9V114.1C125 118.1 126.8 120.4 129.8 121.6V121.8H106.9V121.6C109.9 120.3 111.7 118.1 111.7 114.1V82L90.2 117.2L68.6 82V114.1C68.6 118.1 70.4 120.4 73.4 121.6V121.8H50.5V121.6C53.5 120.3 55.3 118.1 55.3 114.1V65.9C55.3 61.9 53.5 59.6 50.5 58.4V58.2H69.3L90.2 93.5L111 58.2H129.8V58.4Z" fill="#3C3D3A"/>
        </svg>
    </a>

    <!-- Hamburger Button -->
    <button id="menu-toggle" 
      class="xl:hidden text-gray-400 hover:text-[var(--hover-color)] focus:outline-none" 
      aria-label="Toggle menu" 
      style="--hover-color:#{{ globals.contrastColorOne }};">
      <!-- Hamburger icon -->
      <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" 
        class="h-6 w-6 stroke-current" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <!-- Close icon -->
      <svg id="close-icon" xmlns="http://www.w3.org/2000/svg" 
        class="h-6 w-6 stroke-current hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5">
        <path d="M6 6l12 12M6 18L18 6" />
      </svg>
    </button>
  </div>

  <!-- Full-Screen Nav Overlay -->
  <div id="nav-links" class=" hidden fixed inset-0 flex flex-col items-center justify-center space-y-[20px] 
           xl:static xl:flex xl:flex-row xl:items-center xl:justify-evenly xl:space-y-0 xl:space-x-[20px] 
           xl:bg-transparent xl:h-auto xl:w-full transition-all duration-500 ease-in-out" style="background-color: #{{ globals.darkBackground }};">
    {{ _self.navLink('About', '/about') }}
    {% for category in categories %}
      {{ _self.navLink(category.title, category.url) }}
    {% endfor %}
    {{ _self.navLink('Contact', '/contact') }}
  </div>
</nav>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const toggle = document.getElementById('menu-toggle');
    const navLinks = document.getElementById('nav-links');
    const hamburger = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    toggle.addEventListener('click', () => {
      const isOpen = !navLinks.classList.contains('hidden');

      // Toggle menu visibility
      navLinks.classList.toggle('hidden');
      hamburger.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');

      // Prevent background scroll when menu is open
      document.body.style.overflow = isOpen ? 'auto' : 'hidden';
    });
  });
</script>
