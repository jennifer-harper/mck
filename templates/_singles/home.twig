{% extends "_layout.twig" %} 
{% set bodyAttributes ={ class: "home" } %} 
{% set docTitle = entry.title %} 
{% set metaDesc = entry.metaDescription %} 



{% set all = craft.entries()
    .section('portfolio')
    .with([['mainImage']])
    .orderBy('postDate desc')
    .all() %} 



{% block content %} 
    <div style="background-color: #{{ globals.darkBackground }};">
        <div class="flex flex-col justify-center text-center text-white p-[20px] pt-[100px] lg:pt-[12vw]  lg:pb-[6vw]">
            {# {% set image = entry.logoImage.one %}
            {% if image %}
                <img src="{{ image.getUrl() }}" alt="" >
            {% endif %} #}
            <div class="px-[20px] lg:px-[20vw] xl:px-[25vw] mb-[40px] md:mb-[4vw]">
                {% include '_components/logo-svg' %}
            </div>
            <div class="p-[20px] lg:px-[15vw] xl:px-[20vw] text-balance">
                {% if entry.mainHeading %} 
                   <h1> {{entry.mainHeading}}</h1>
                {% endif %}
            </div>
            <div class="p-[20px] lg:px-[25vw] xl:px-[30vw] text-balance">
                {% if entry.smallParagraph %} 
                    {{entry.smallParagraph}}
                {% endif %}
            </div>
        </div>  

        <div class="flex flex-col justify-center text-center p-[20px] lg:p-[2vw]" style="background-color: #{{ globals.lightBackground }};">
            {% if entry.smallTitle %} 
               <h2> {{entry.smallTitle}}</h2>
            {% endif %}
        </div>    

        <div class="flex flex-col md:flex-row md:flex-wrap overflow-hidden">
            {% if all|length %}
            {% for entry in all %} 
            {% set image = entry.mainImage.one() %}
            {% set hide = entry.showHide and 'hideContent' in entry.showHide %}
            {% set special = entry.selectedProject and 'selected' in entry.selectedProject %}
                {% if special %}
                    {% include '_components/project-grid-hide' %}
                {% endif %}
            {% endfor %} 
            {% endif %}
        </div>

        <div class="flex flex-col justify-center text-center text-white p-[20px]  lg:pt-[8vw]  lg:pb-[6vw]">
            <div class="p-[20px] lg:px-[25vw] xl:px-[30vw] text-balance">
                {% if entry.smallParagraph2 %} 
                    {{entry.smallParagraph2}}
                {% endif %}
            </div>
        </div>  

        <div class="flex flex-col lg:flex-row justify-center text-center  pt-[40px]  lg:py-[4vw]" style="background-color: #{{ globals.contrastColorOne }};">
            {% for block in entry.threeColumnParagraphs %}
                {% if block.type == "threeColumnGroup" %}
                <div class="px-[20px] pb-[40px] lg:pb-0 md:px-[5vw]  lg:px-[4vw]  xl:px-[7vw] flex flex-col items-center">
                        <h2 class="pb-[20px] lg:pb-[1vw]"> {{ block.title }} </h2>
                    <div class="width-full max-w-[50%] md:max-w-[100%]">{{ block.smallParagraph}}</div>
                </div>
                {% endif %}
            {% endfor %}
        </div>

        <div class="flex flex-col justify-center text-center text-white p-[20px]  lg:pt-[8vw]  lg:pb-[6vw]">
            <div class="p-[20px] lg:px-[15vw] xl:px-[25vw] text-balance">
                {% if entry.smallParagraph3 %} 
                    {{entry.smallParagraph3}}
                {% endif %}
            </div>
        </div>  


        <div class="flex flex-col md:flex-row md:flex-wrap overflow-hidden">
            {% if all|length %}
            {% for entry in all %} 
            {% set image = entry.mainImage.one() %}
            {% set hide = entry.showHide and 'hideContent' in entry.showHide %}
            {% set special = entry.selectedProject and 'selected' in entry.selectedProject %}
                {% if not special %}
                    {% include '_components/project-grid-hide' %}
                {% endif %}
            {% endfor %} 
            {% endif %}
        </div>

        <div class="flex flex-col justify-center text-center text-white p-[20px]  lg:pt-[8vw]  lg:pb-[6vw]">
            <div class="p-[20px] lg:px-[15vw] xl:px-[25vw] text-balance  mb-[20px] lg:mb-[1vw]">
                {% if entry.smallParagraph4 %} 
                    {{entry.smallParagraph4}}
                {% endif %}
            </div>
           <a href="/contact" class="contactBtn uppercase tracking-[.3em]" style="--hover-color:#{{ globals.contrastColorOne }};">
            Contact
            </a>
        </div>         
    </div>



{% endblock %}



